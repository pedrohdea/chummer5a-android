<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Head Android. Hospeda a MESMA UI do Chummer.Desktop; nada de domínio entra aqui.

    Neste momento o projeto tem duas funções: provar que o APK sai deste contêiner e
    carregar os assets de jogo para que os spikes de risco de plataforma possam ser medidos
    com o aparelho na mão (Etapa 2.5).
  -->

  <PropertyGroup>
    <TargetFramework>net9.0-android35.0</TargetFramework>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ApplicationId>com.chummer5a.android</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!--
      O SDK Android emite XA4218/XA4301 e avisos de binding de terceiros que nada têm a ver
      com o nosso código. TreatWarningsAsErrors vale para o C#; aqui ele transformaria ruído
      de empacotamento em falha de build.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors />
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
    <!-- Mesma fonte nos dois heads: sem isso, a tela do desktop e a do aparelho medem
         layouts diferentes e o Chummer.Desktop deixa de ser um substituto honesto. -->
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chummer.UI\Chummer.UI.csproj" />
  </ItemGroup>

  <!--
    Os dados de jogo entram no APK como assets, lidos em tempo de execução pelo AssetManager.

    Por que assets e não recursos embarcados na assembly: recurso embarcado é descomprimido
    para a memória gerenciada no primeiro acesso e fica lá; asset é um arquivo dentro do APK,
    aberto sob demanda e fechado depois. Com ~20 MB de XML num aparelho, a diferença não é
    estilo — é o pico de memória que a Etapa 2.5 existe para medir.

    A pasta continua sendo a de Chummer/: uma fonte da verdade, como em DEC-013. Copiar os
    dados para src/ criaria duas cópias que divergiriam em silêncio.
  -->
  <PropertyGroup>
    <ChummerAssetsRoot>$(MSBuildThisFileDirectory)..\..\Chummer\</ChummerAssetsRoot>
    <!-- Defina EmbedGameData=false para medir o tamanho do APK sem os dados. -->
    <EmbedGameData Condition="'$(EmbedGameData)' == ''">true</EmbedGameData>
  </PropertyGroup>

  <ItemGroup Condition="'$(EmbedGameData)' == 'true'">
    <AndroidAsset Include="$(ChummerAssetsRoot)data\**\*.xml"
                  Link="Assets\data\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="$(ChummerAssetsRoot)sheets\**\*.xsl;$(ChummerAssetsRoot)sheets\**\*.xslt"
                  Link="Assets\sheets\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="$(ChummerAssetsRoot)lang\**\*.xml"
                  Link="Assets\lang\%(RecursiveDir)%(Filename)%(Extension)" />
    <AndroidAsset Include="$(ChummerAssetsRoot)customdata\**\*.*"
                  Link="Assets\customdata\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
