<?xml version="1.0" encoding="utf-8"?>
<resources>

  <!--
    Sem ActionBar: o Avalonia desenha a tela inteira e a barra nativa só rouba altura útil,
    que num celular é o recurso mais escasso.
  -->
  <style name="MyTheme.NoActionBar" parent="@android:style/Theme.Material.Light.NoActionBar">
    <item name="android:windowNoTitle">true</item>
    <item name="android:windowActionBar">false</item>
  </style>

</resources>
