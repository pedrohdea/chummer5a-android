<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Chummer.UI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="800"
             x:Class="Chummer.UI.Views.MainView"
             x:DataType="vm:MainViewModel">

  <Grid RowDefinitions="*,Auto,Auto">

    <!-- Presentation block, centred in the space the menu does not use. -->
    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                Margin="24" Spacing="8">
      <TextBlock Text="{Binding Title}"
                 FontSize="44" FontWeight="Bold"
                 HorizontalAlignment="Center" />
      <TextBlock Text="{Binding Subtitle}"
                 FontSize="14" Opacity="0.7" TextWrapping="Wrap"
                 TextAlignment="Center" HorizontalAlignment="Center" />
    </StackPanel>

    <ItemsControl Grid.Row="1" ItemsSource="{Binding Menu}" Margin="24,0,24,8">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:MenuEntry">
          <!-- IsEnabled="False" is the point of the skeleton, not a placeholder: nothing
               behind these entries exists yet. The note keeps a greyed button from reading
               as a defect during QA. -->
          <Button IsEnabled="False"
                  HorizontalAlignment="Stretch"
                  HorizontalContentAlignment="Left"
                  Padding="16,12" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding Label}" FontSize="15" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Note}" FontSize="11" Opacity="0.6"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <TextBlock Grid.Row="2" Text="{Binding BuildLine}"
               FontSize="11" Opacity="0.55" TextWrapping="Wrap"
               TextAlignment="Center" HorizontalAlignment="Center"
               Margin="16,0,16,16" />

  </Grid>

</UserControl>
